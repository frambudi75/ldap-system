# ========================================================
# LDAP Server & Management System Environment Configuration
# ========================================================

# Database Config (Docker container internal network)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=ldap_server_db
DB_USER=ldap_user
DB_PASS=ldap_secret_password
DB_ROOT_PASS=root_secret_password

# LDAP Daemon Config
LDAP_HOST=0.0.0.0
LDAP_PORT=389
BASE_DN=dc=internal,dc=net
ADMIN_BIND_DN=cn=admin,dc=internal,dc=net
ALLOW_ANONYMOUS=true

# Host Exposure Ports
WEB_PORT=8080
HOST_LDAP_PORT=389
HOST_MYSQL_PORT=3307
